class Solution {
    public void rotateMatrix(int[][] mat) {
        int R=mat.length;
        int C=mat[0].length;
        for(int i=0;i<R;i++){
            for(int j=i+1;j<C;j++){
                int temp=mat[i][j];
                mat[i][j]=mat[j][i];
                mat[j][i]=temp;
            }
        }
        for(int i=0;i<C;i++){
            int left=0, right=R-1;
            while(right>left){
                int temp=mat[right][i];
                mat[right][i]=mat[left][i];
                mat[left][i]=temp;
                left++;
                right--;
            }
        }
    }
}
