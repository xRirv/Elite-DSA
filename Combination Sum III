class Solution {
    public void backtrack(int k, int target, List<Integer> current, int num, List<List<Integer>> l1){
        if(k==0){
            if(target==0){
                l1.add(new ArrayList<>(current));
            }
            return;
        }
        if(num>9||target<0){
            return;
        }
        current.add(num);
        backtrack(k-1,target-num, current, num+1, l1 );
        current.remove(current.size()-1);
        backtrack(k, target, current, num+1, l1);
    }
    public List<List<Integer>> combinationSum3(int k, int n) {
        List<List<Integer>> l1=new ArrayList<>();
        backtrack(k, n, new ArrayList<>(), 1, l1);
        return l1;
    }
}
